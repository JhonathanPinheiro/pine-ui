{
  "name": "pine-ui",
  "version": "0.1.3",
  "private": true,
  "description": "Modern React component library with design tokens",
  "license": "MIT",
  "author": "Pine UI",
  "packageManager": "pnpm@10.33.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/JhonathanPinheiro/pine-ui"
  },
  "homepage": "https://github.com/JhonathanPinheiro/pine-ui",
  "bugs": {
    "url": "https://github.com/JhonathanPinheiro/pine-ui/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "publish:tokens": "npm publish --access=public --workspace=packages/tokens",
    "publish:core": "npm publish --access=public --workspace=packages/core",
    "publish:all": "npm publish --access=public --workspace=packages/tokens --workspace=packages/core"
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  }
}